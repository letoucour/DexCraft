# En-têtes de sécurité pour Cloudflare Pages (préparé en 0.8.7 ; ignoré par GitHub Pages).
# Mêmes règles que la balise Content-Security-Policy d'index.html, plus ce qu'une balise ne peut pas faire :
# interdire d'afficher le jeu dans le cadre d'un autre site (frame-ancestors, X-Frame-Options).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Service worker des notifications (1.10.0) : rangé dans images/ (publié sans changer la commande de Cloudflare Pages), il
# s'occupe de tout le site grâce à Service-Worker-Allowed ; jamais gardé en cache.
/images/sw.js
  Service-Worker-Allowed: /
  Cache-Control: no-cache
